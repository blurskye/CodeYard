+package runner
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+// EnvironmentValues are bound to admitted job IDs, never merged into Config.Secrets.
+type EnvironmentValues struct {
+	Jobs         map[string]string           `json:"jobs"`
+	Environments map[string]EnvironmentScope `json:"environments"`
+}
+
+type EnvironmentScope struct {
+	Secrets   map[string]string `json:"secrets"`
+	Variables map[string]string `json:"variables"`
+}
+
+func validEnvironmentValues(values map[string]string, budget int) bool {
+	if values == nil || len(values) > 100 {
+		return false
+	}
+	names := make(map[string]bool)
+	total := 0
+	for name, value := range values {
+		upper := strings.ToUpper(name)
+		if len(name) == 0 || len(name) > 255 || names[upper] || strings.HasPrefix(upper, "GITHUB_") || len(value) > 48*1024 || strings.ContainsRune(value, 0) {
+			return false
+		}
+		names[upper] = true
+		for i := 0; i < len(name); i++ {
+			b := name[i]
+			if !((b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z') || b == '_' || (i > 0 && b >= '0' && b <= '9')) {
+				return false
+			}
+		}
+		total += len(name) + len(value)
+	}
+	return total <= budget
+}
+
+// LoadEnvironmentValues deliberately discards decoder errors which could quote a value.
+func LoadEnvironmentValues(path string) (EnvironmentValues, error) {
+	var values EnvironmentValues
+	if path == "" {
+		return values, nil
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return values, errors.New("unable to read environment values file")
+	}
+	defer file.Close()
+	data, err := io.ReadAll(io.LimitReader(file, 16*1024*1024+1))
+	if err != nil || len(data) > 16*1024*1024 || !utf8.Valid(data) {
+		return values, errors.New("invalid environment values file")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&values) != nil {
+		return EnvironmentValues{}, errors.New("invalid environment values file")
+	}
+	var extra interface{}
+	if decoder.Decode(&extra) != io.EOF || values.Jobs == nil || values.Environments == nil || len(values.Jobs) > 1024 || len(values.Environments) > 1024 {
+		return EnvironmentValues{}, errors.New("invalid environment values file")
+	}
+	for job, scope := range values.Jobs {
+		if _, exists := values.Environments[scope]; job == "" || len(job) > 255 || !exists {
+			return EnvironmentValues{}, errors.New("invalid environment value binding")
+		}
+	}
+	for name, scope := range values.Environments {
+		if name == "" || len(name) > 2048 || !validEnvironmentValues(scope.Secrets, 1024*1024) || !validEnvironmentValues(scope.Variables, 256*1024) {
+			return EnvironmentValues{}, errors.New("invalid environment value scope")
+		}
+	}
+	return values, nil
+}
+
+func (values EnvironmentValues) forJob(job string) EnvironmentScope {
+	scope, exists := values.Jobs[job]
+	if !exists {
+		return EnvironmentScope{}
+	}
+	return values.Environments[scope]
+}
+
+func (rc *RunContext) environmentScope() EnvironmentScope {
+	// A called workflow cannot borrow a same-named job's scope from its caller.
+	if rc.Run == nil || rc.caller != nil {
+		return EnvironmentScope{}
+	}
+	return rc.Config.EnvironmentValues.forJob(rc.Run.JobID)
+}
+
+func overlayEnvironmentValues(base, overlay map[string]string) map[string]string {
+	if len(overlay) == 0 {
+		return base
+	}
+	result := make(map[string]string, len(base)+len(overlay))
+	for key, value := range base {
+		result[key] = value
+	}
+	for key, value := range overlay {
+		for existing := range result {
+			if strings.EqualFold(existing, key) {
+				delete(result, existing)
+			}
+		}
+		result[key] = value
+	}
+	return result
+}
+
+func (config *Config) maskedSecrets() map[string]string {
+	// Synthetic indices avoid dropping either value when two scopes shadow a name.
+	result := make(map[string]string)
+	for _, value := range config.Secrets {
+		result[strconv.Itoa(len(result))] = value
+	}
+	for _, scope := range config.EnvironmentValues.Environments {
+		for _, value := range scope.Secrets {
+			result[strconv.Itoa(len(result))] = value
+		}
+	}
+	return result
+}
