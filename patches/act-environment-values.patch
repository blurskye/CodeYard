+package runner
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestEnvironmentValuesFollowJobBindings(t *testing.T) {
+	base := map[string]string{"token": "repository-secret", "GITHUB_TOKEN": "job-token"}
+	values := EnvironmentValues{Jobs: map[string]string{"deploy": "i\u0307"}, Environments: map[string]EnvironmentScope{"i\u0307": {Secrets: map[string]string{"TOKEN": "environment-secret"}, Variables: map[string]string{"COLOR": "visible-variable"}}}}
+	for _, test := range []struct{ job, want string }{{"ordinary", "repository-secret"}, {"deploy", "environment-secret"}} {
+		actual := overlayEnvironmentValues(base, values.forJob(test.job).Secrets)
+		found := ""
+		for name, value := range actual {
+			if strings.EqualFold(name, "TOKEN") {
+				found = value
+			}
+		}
+		if found != test.want || actual["GITHUB_TOKEN"] != "job-token" || base["token"] != "repository-secret" {
+			t.Fatal("environment values escaped their job binding or mutated the base context")
+		}
+	}
+	if values.forJob("ordinary").Variables != nil || values.forJob("deploy").Variables["COLOR"] != "visible-variable" {
+		t.Fatal("variables escaped their job binding")
+	}
+}
+
+func TestEnvironmentValuesMalformedFilesDoNotDiscloseValues(t *testing.T) {
+	for _, content := range []string{
+		`{"jobs":{},"environments":{"prod":{"secrets":"private-marker","variables":{}}}}`,
+		`{"jobs":{},"environments":{}} {}`,
+		`{"jobs":{},"environments":{},"unknown":"private-marker"}`,
+		`{"jobs":{"deploy":"missing"},"environments":{}}`,
+		`{"jobs":{"deploy":"prod"},"environments":{"prod":{"secrets":{"GITHUB_TOKEN":"private-marker"},"variables":{}}}}`,
+		`{"jobs":{},"environments":{"prod":{"secrets":{"TOKEN":`,
+	} {
+		path := filepath.Join(t.TempDir(), "values.json")
+		if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+			t.Fatal(err)
+		}
+		_, err := LoadEnvironmentValues(path)
+		if err == nil || strings.Contains(err.Error(), "private-marker") {
+			t.Fatal("invalid values must be rejected without their contents")
+		}
+	}
+}
+
+func TestEnvironmentValuesValidFilesAndLimits(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "values.json")
+	content := `{"jobs":{"deploy":"prod"},"environments":{"prod":{"secrets":{"TOKEN":"environment-secret"},"variables":{"COLOR":"visible-variable"}}}}`
+	if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	values, err := LoadEnvironmentValues(path)
+	if err != nil || values.forJob("deploy").Secrets["TOKEN"] != "environment-secret" {
+		t.Fatal("valid values were not loaded")
+	}
+	if validEnvironmentValues(map[string]string{"TOKEN": strings.Repeat("x", 48*1024+1)}, 1024*1024) || validEnvironmentValues(map[string]string{"TOKEN": "nul\x00value"}, 1024*1024) {
+		t.Fatal("invalid values were accepted")
+	}
+}
+
+func TestEnvironmentValuesMaskBothShadowedAndEnvironmentSecrets(t *testing.T) {
+	config := Config{Secrets: map[string]string{"TOKEN": "repository-secret"}, EnvironmentValues: EnvironmentValues{Environments: map[string]EnvironmentScope{"prod": {Secrets: map[string]string{"TOKEN": "environment-secret"}}}}}
+	want := map[string]bool{"repository-secret": true, "environment-secret": true}
+	actual := config.maskedSecrets()
+	if len(actual) != len(want) {
+		t.Fatal("a shadowed secret was dropped")
+	}
+	for _, value := range actual {
+		delete(want, value)
+	}
+	if len(want) != 0 {
+		t.Fatal("both scopes must be masked")
+	}
+}
