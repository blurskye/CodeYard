{
  "problemMatcher": [
    {
      "owner": "compiler",
      "pattern": [{
        "regexp": "^(.*):(\\d+):(\\d+): (warning|error) (E\\d+): (.*)$",
        "file": 1, "line": 2, "column": 3, "severity": 4, "code": 5, "message": 6
      }]
    },
    {
      "owner": "multiline",
      "severity": "notice",
      "fromPath": "subdir/project.json",
      "pattern": [
        {"regexp": "^file: (.*)$", "file": 1},
        {"regexp": "^(\\d+): (.*)$", "line": 1, "message": 2, "loop": true}
      ]
    }
  ]
}
