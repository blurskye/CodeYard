# Copy to .env and edit. The server reads .env at startup (dotenvy), and Docker
# Compose reads it for ${VAR} substitution. This file lists the operator settings
# the server reads. Leave optional settings unset unless needed; an empty value
# is not always a default and may be invalid. Compose substitutions apply separately.
# Commented lines are optional. compose.yaml sets GITSERV_STATE_DIR and
# SSH_MODE for the container, so leave those two commented out when you use Compose.
#
# Compose-only variables are listed at the end.

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Optional. Database URL: postgres://... or postgresql://... selects PostgreSQL;
# sqlite:... selects a SQLite file. Unset: SQLite at $GITSERV_STATE_DIR/gitserv.db.
# Database URLs are environment-only; --database-url is refused to keep secrets out
# of argv.
# Compose requires DATABASE_URL with hostname postgres and percent-encoded credentials.
# DATABASE_URL=postgres://gitserv:change-me@localhost:5432/gitserv
# Only for `codeyard db copy`: the source database and the empty destination, as
# sqlite://PATH or postgres://... (the --from and --to options take the same values).
# COPY_FROM_DATABASE_URL=
# COPY_TO_DATABASE_URL=
# Default ./data. Holds the default SQLite database and local uploads (objects/).
# GITSERV_STATE_DIR=./data
# Default ./repos. Bare Git repositories, one directory per repository.
REPOS_PATH=./repos
# Default ./host_key. Built-in SSH host key, generated if missing.
HOST_KEY_PATH=./host_key

# Optional S3-compatible object storage for uploads. Setting any S3_ variable below,
# even to an empty value (including S3_REGION=), turns S3 on; then S3_ENDPOINT,
# S3_ACCESS_KEY, S3_SECRET_KEY and S3_BUCKET must all be nonempty.
# Web nodes using S3 also require PUBLIC_URL. The server creates the bucket at start-up.
# Leave all S3 settings unset for local uploads in $GITSERV_STATE_DIR/objects.
# S3_ENDPOINT=http://localhost:9000
# Default S3_ENDPOINT. This browser-facing URL must use a hostname outside the
# session cookie scope; a different scheme or port on the forge hostname is not
# enough. Compose requires an explicit browser-reachable value; production needs HTTPS.
# S3_PUBLIC_ENDPOINT=http://objects.localhost:9000
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# S3_BUCKET=gitserv-files
# Unset: us-east-1. Empty is invalid.
# S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Server and roles
# -----------------------------------------------------------------------------
# Services this node runs: any of web, storage, ssh, actions-worker. Default: all
# four. serve needs storage, and web or ssh.
# GITSERV_NODE_ROLES=web,storage,ssh,actions-worker
# Default 0.0.0.0:3000. Compose fixes this listener; use API_HTTP_PORT for its host port.
HTTP_ADDR=0.0.0.0:3000
# Browser bundle built by scripts/build-webui.sh. Default
# target/dx/codeyard/release/web/public under the working directory.
# WEBUI_DIST=./dist/webui
# Log filter, e.g. info or codeyard=debug. Default info.
# RUST_LOG=info

# -----------------------------------------------------------------------------
# Git over SSH
# -----------------------------------------------------------------------------
# auto (default): host OpenSSH on a host that runs sshd and has the codeyard OpenSSH
# setup installed; the built-in server on a host without sshd; SSH off inside
# containers. auto never binds port 22. openssh, builtin or disabled force a choice.
# Install the host OpenSSH setup with scripts/install-openssh.py.
# SSH_MODE=auto
# Built-in SSH listener, used in builtin mode.
SSH_ADDR=0.0.0.0:2222
# Optional comma-separated IPs of trusted proxies that send a PROXY v1 header to the
# built-in SSH listener. Only these peers may supply a PROXY v1 source address; do not
# include ordinary client networks.
# SSH_TRUSTED_PROXY_IPS=10.0.0.10
# Default /run/codeyard/ssh.sock. Used only by host OpenSSH mode.
SSH_SOCKET_PATH=/run/codeyard/ssh.sock
# Default git. Login name used in clone URLs with host OpenSSH.
SSH_GIT_USER=git
# Default /etc/codeyard/openssh.json. Written by scripts/install-openssh.py.
SSH_INSTALL_MANIFEST=/etc/codeyard/openssh.json

# -----------------------------------------------------------------------------
# Git limits
# -----------------------------------------------------------------------------
# Clones, fetches and pushes running at once on this node, over HTTP and SSH.
# Default: four per CPU core, at least 16.
# GIT_SESSION_LIMIT=16
# Seconds a Git request waits for a free slot before it fails as busy. Default 30.
# GIT_SESSION_WAIT_SECONDS=30
# Address space for one Git read command (blame, diff, merge-tree), in MiB.
# Default 4096; 0 for no limit.
# GIT_COMMAND_MEMORY_MIB=4096

# -----------------------------------------------------------------------------
# Public URLs, sessions and admin
# -----------------------------------------------------------------------------
# Exact public origin, no path. Used for same-origin checks, OAuth redirects, links in mail and
# cookies. Use an https:// address in production; http://localhost is for local
# development. With an https:// address, session cookies are always Secure.
PUBLIC_URL=http://localhost:3000
# Optional. HTTP clone base shown in the UI. PUBLIC_HTTP_CLONE_BASE defaults to
# PUBLIC_URL, and to http://localhost:3000 when neither is set.
# PUBLIC_HTTP_CLONE_BASE=https://git.example.com
# Optional. SSH clone base shown in the UI, e.g. ssh://git@git.example.com:22.
# PUBLIC_SSH_CLONE_BASE=
# Optional. Cookie domain for session cookies.
# COOKIE_DOMAIN=
# Default false. Set true to mark session cookies Secure without an https PUBLIC_URL.
COOKIE_SECURE=false
# Default 30. Values outside 1-365 use 30.
SESSION_DURATION_DAYS=30
# Optional. Comma-separated origins allowed for cross-origin API calls. Default none: the
# app and its API share one origin.
# CORS_ORIGINS=https://app.example.com
# Optional. Comma-separated IPs of reverse proxies in front of the HTTP server. Only these
# peers may name the client in X-Forwarded-For; failed sign-ins are limited per client
# address. Without it every visitor behind the proxy shares one limit.
# HTTP_TRUSTED_PROXY_IPS=127.0.0.1
# Optional. When set, the /setup form must send this exact value. Pick a long
# random string.
# ADMIN_SECRET=
# Optional. 64 hex characters (32 bytes) that encrypt repository and organization
# Actions secrets. Generate it once and keep it: a different key makes existing
# secrets unreadable. Only unset disables the secrets feature; an empty or malformed
# value fails server startup. compose.yaml requires a nonempty, valid key.
# SECRETS_MASTER_KEY=

# -----------------------------------------------------------------------------
# OAuth sign-in (optional). Set both values of a pair to enable the provider.
# Redirect URLs are PUBLIC_URL plus /api/auth/oauth/<provider>/callback.
# -----------------------------------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Actions (CI). Only nodes with the actions-worker role run jobs.
# -----------------------------------------------------------------------------
# podman (default) runs jobs in containers through act and the Podman socket below.
# local runs act on the host with no container isolation (trusted runners only).
CI_EXECUTION_MODE=podman
# Optional. Comma-separated user IDs allowed to run workflows, besides site admins.
# CI_TRUSTED_ACTOR_IDS=
# Default 4. How many runs this node executes at the same time. There is no
# per-repository limit.
CI_MAX_ACTIVE_RUNS=4
# Default 3600. A run is stopped after this many seconds.
CI_RUN_TIMEOUT_SECONDS=3600
# Default $XDG_RUNTIME_DIR/podman/podman.sock, or /run/user/1000/podman/podman.sock
# when XDG_RUNTIME_DIR is unset. Anyone who can use this socket can run code as that
# host user.
# CI_PODMAN_SOCKET=/run/user/1000/podman/podman.sock
# Default act (found on PATH).
# CI_ACT_BINARY=act
# Default ghcr.io/catthehacker/ubuntu:act-latest.
CI_ACT_RUNNER_IMAGE=ghcr.io/catthehacker/ubuntu:act-latest
# Optional. Extra runs-on label mappings, comma-separated label=image pairs,
# e.g. ubuntu-24.04=docker.io/library/ubuntu:24.04.
# CI_ACT_PLATFORM_MAP=
# Default .github/workflows/ci.yml and .github/workflows/deploy-image.yml.
CI_WORKFLOW_CI=.github/workflows/ci.yml
CI_WORKFLOW_CD=.github/workflows/deploy-image.yml

# -----------------------------------------------------------------------------
# Compose only (compose.yaml). The server does not read these.
# -----------------------------------------------------------------------------
# GIT_SERV_DATA_ROOT=./data
# API_HTTP_BIND=0.0.0.0
# API_HTTP_PORT=11000
# SSH_BIND=0.0.0.0
# SSH_PORT=2222
# POSTGRES_USER=gitserv
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=gitserv
# RUSTFS_API_BIND=0.0.0.0
# RUSTFS_API_PORT=11002
# RUSTFS_CONSOLE_BIND=127.0.0.1
# RUSTFS_CONSOLE_PORT=11003

# -----------------------------------------------------------------------------
# Cluster (core nodes need PostgreSQL; database-free workers dial cores)
# -----------------------------------------------------------------------------
# With none of these set, `serve` is a plain single node and opens no cluster port.
# Setting NODE_KEY, NODE_KEY_FILE, CLUSTER_NODES, CLUSTER_NODES_FILE, CLUSTER_JOIN_TOKEN,
# CLUSTER_PEERS, CLUSTER_TCP_BIND, IROH_BIND, IROH_RELAY or IROH_ADVERTISE turns cluster
# mode on (NODE_NAME alone does not). Core nodes listen on UDP (IROH_BIND), TCP
# (CLUSTER_TCP_BIND) or both; a worker-only node without DATABASE_URL dials out only.
# UDP address for node-to-node traffic (default 0.0.0.0:7444). Publish this UDP port.
# IROH_BIND=0.0.0.0:7444
# Host side of the published UDP port in compose.yaml.
# IROH_PUBLISH_BIND=0.0.0.0
# IROH_PORT=7444
# Addresses other nodes should dial when the bound one is not reachable from outside
# (NAT, container port mapping), as host:port separated by commas.
# IROH_ADVERTISE=
# Relays carry traffic when two nodes cannot connect directly. Unset = direct only;
# n0 = the public relays run by the iroh project; or the URL(s) of your own relay.
# IROH_RELAY=
# TCP address for node connections over TLS (unset = no TCP listener).
# In the container, use 0.0.0.0:7445, the port compose.yaml publishes.
# CLUSTER_TCP_BIND=0.0.0.0:7445
# Host side of the published TCP port in compose.yaml.
# CLUSTER_TCP_PUBLISH_BIND=0.0.0.0
# CLUSTER_TCP_PORT=7445
# host:port entries peers dial over TCP, separated by commas. Without them the bind
# address is advertised, unless it is 0.0.0.0 or ::.
# CLUSTER_TCP_ADVERTISE=
# Name shown in `codeyard cluster list` and in CI logs (defaults to the host name;
# lowercase letters, digits, '.', '_' and '-').
# NODE_NAME=
# This node's secret key from `codeyard cluster keygen`. Without one, a key is generated
# in GITSERV_STATE_DIR/node.key and reused.
# NODE_KEY=
# NODE_KEY_FILE=
# Members declared up front, on core nodes: <public key>:<roles>:<name>, separated by
# commas or new lines. Join several roles with + (for example web+ssh).
# CLUSTER_NODES=
# CLUSTER_NODES_FILE=
# Ticket from `codeyard cluster invite --reusable --roles <roles> --expires 30d`.
# A node started with it pairs itself on first boot and reuses its saved key afterwards.
# `cluster join` also reads its one-time ticket here; argv tickets are refused.
# CLUSTER_JOIN_TOKEN=
# Ordered core addresses for database-free workers (or use the saved join address).
# CLUSTER_PEERS=<public-key>@<host:port>,<public-key>@<host:port>

# Outgoing email, used until settings are saved under Admin, Email. Mail carries codes to
# paste; it has links only when PUBLIC_URL is set.
# CODEYARD_SMTP_HOST=
# CODEYARD_SMTP_PORT=
# CODEYARD_SMTP_SECURITY=starttls
# CODEYARD_SMTP_USERNAME=
# CODEYARD_SMTP_PASSWORD=
# CODEYARD_SMTP_FROM=Codeyard <noreply@example.com>
# CODEYARD_SMTP_REPLY_TO=
